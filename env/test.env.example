# ================================================================
# 测试环境 — /www/dazistar-test
# 域名: http://test.dazistar.com  →  PM2 dazistar-3001  →  端口 3001
# 部署: bash scripts/deploy-test.sh
# ================================================================

PORT=3001
NODE_ENV=production

# 对外访问地址（next build 前写入，供将来 NEXT_PUBLIC_* 使用）
NEXT_PUBLIC_APP_URL="http://test.dazistar.com"
NEXTAUTH_URL="http://test.dazistar.com"

# 建议与生产使用不同数据库，避免测试数据污染生产
# DATABASE_URL="postgresql://dazistar:密码@localhost:5432/dazistar_test"

# 测试环境可开启 MOCK，生产务必关闭
# ID_VERIFY_MOCK=true
# ALIYUN_ID_VERIFY_ENABLED=false
