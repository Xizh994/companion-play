// This is your Prisma schema file,
// learn more about it in our docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户角色枚举
// ============================================================
enum UserRole {
  PLAYER
  BOSS
  SHOP
}

// 验证码类型枚举
enum VerificationCodeType {
  SMS_REGISTER
  SMS_LOGIN
  EMAIL_BIND
  EMAIL_RECOVERY
  EMAIL_CHANGE_PWD
  MAGIC_LINK
}

// 认证状态枚举
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// 实名认证状态枚举
enum RealNameStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// 用户基础表（所有角色的公共信息）
// ============================================================
model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  passwordHash  String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  hasPassword   Boolean   @default(true)
  role          UserRole  @default(BOSS)
  nickname      String
  avatar        String?
  bio           String?
  status        String    @default("online")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  verification         Verification?
  playerProfile        PlayerProfile?
  shopProfile          ShopProfile?
  realNameVerification RealNameVerification?
  sentMessages         Message[]           @relation("SentMessages")
  receivedMessages     Message[]           @relation("ReceivedMessages")
  verificationCodes    VerificationCode[]

  @@map("users")
}

// ============================================================
// 个人陪玩认证资料
// ============================================================
model PlayerProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 基本信息
  realName       String
  idCardNumber   String
  idCardFront    String
  idCardBack     String
  gender         String?
  birthday       DateTime?

  // 服务相关
  gameCategories String[]
  pricePerHour   Decimal?           @db.Decimal(10,2)
  serviceTags    String[]
  serviceDesc    String?

  // 认证状态
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("player_profiles")
}

// ============================================================
// 陪玩店认证资料
// ============================================================
model ShopProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 店铺信息
  shopName       String
  shopCover      String?
  shopBanner     String?
  shopDesc       String?
  shopAddress    String?

  // 营业执照/实景照片
  licenseType    String
  licenseImage   String

  // 负责人信息
  contactName    String
  contactPhone   String
  contactIdCard  String?

  // 认证状态
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?

  // 店铺统计
  playerCount    Int        @default(0)
  rating         Decimal?   @db.Decimal(3,2)
  orderCount     Int        @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shop_profiles")
}

// ============================================================
// 老板实名认证
// ============================================================
model RealNameVerification {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName      String
  idCardNumber  String
  status        RealNameStatus  @default(PENDING)
  notes         String?
  submittedAt   DateTime        @default(now())
  verifiedAt    DateTime?

  @@index([status])
  @@map("real_name_verifications")
}

// ============================================================
// 验证码记录
// ============================================================
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String
  code       String
  type      VerificationCodeType
  expiresAt DateTime
  used      Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([target, type])
  @@index([expiresAt])
  @@map("verification_codes")
}

// ============================================================
// 认证申请记录（审核后台用）
// ============================================================
model Verification {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicantType  UserRole
  status         VerificationStatus @default(PENDING)
  reviewer       String?
  reviewerNotes  String?
  reviewedAt     DateTime?

  submittedAt    DateTime @default(now())

  @@map("verifications")
}

// ============================================================
// 即时聊天消息
// ============================================================
model Message {
  id          String   @id @default(cuid())
  fromId      String
  from        User     @relation("SentMessages", fields: [fromId], references: [id])
  toId        String
  to          User     @relation("ReceivedMessages", fields: [toId], references: [id])

  // 消息类型
  type        String   @default("text")
  content     String

  // 附加数据（JSON）
  metadata    Json?

  // 状态
  isRead      Boolean  @default(false)
  readAt      DateTime?

  createdAt   DateTime @default(now())

  @@index([toId, isRead])
  @@map("messages")
}

// ============================================================
// 会话记录（用于展示聊天列表）
// ============================================================
model Conversation {
  id          String   @id @default(cuid())
  participants String[]
  lastMessage String?
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("conversations")
}
