// This is your Prisma schema file,
// learn more about it in our docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户角色枚举
// ============================================================
enum UserRole {
  PLAYER // 个人陪玩：预留，当前产品未开放
  BOSS
  SHOP
}

// 验证码类型枚举
enum VerificationCodeType {
  SMS_REGISTER
  SMS_LOGIN
  SMS_RESET_PWD
  EMAIL_BIND
  EMAIL_RECOVERY
  EMAIL_CHANGE_PWD
  MAGIC_LINK
}

// 认证状态枚举
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// 实名认证状态枚举
enum RealNameStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// 用户基础表（所有角色的公共信息）
// ============================================================
model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  passwordHash  String?
  email         String?   @unique
  emailVerified Boolean   @default(false)
  hasPassword   Boolean   @default(true)
  role          UserRole  @default(BOSS)
  nickname      String
  avatar        String?
  bio           String?
  status        String    @default("offline")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 关联
  verification         Verification?
  playerProfile        PlayerProfile?
  shopProfile          ShopProfile?
  realNameVerification RealNameVerification?
  sentMessages         Message[]           @relation("SentMessages")
  receivedMessages     Message[]           @relation("ReceivedMessages")
  verificationCodes    VerificationCode[]

  @@map("users")
}

// ============================================================
// 个人陪玩认证资料
// ============================================================
model PlayerProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 基本信息
  realName       String
  idCardNumber   String
  idCardFront    String
  idCardBack     String
  gender         String?
  birthday       DateTime?

  // 服务相关
  gameCategories String[]
  pricePerHour   Decimal?           @db.Decimal(10,2)
  serviceTags    String[]
  serviceDesc    String?

  // 认证状态
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("player_profiles")
}

// ============================================================
// 陪玩店认证资料
// ============================================================
model ShopProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 店铺信息
  shopName       String
  shopCover      String?
  shopCoverStatus VerificationStatus @default(APPROVED)
  shopBanner     String?
  shopBannerStatus VerificationStatus @default(APPROVED)
  shopDesc       String?
  shopAddress    String?
  slogan         String?

  // 主页价格展示（非交易闭环，仅橱窗）
  priceFrom      Decimal?           @db.Decimal(10, 2)
  priceUnit      String             @default("hour")
  priceNote      String?

  // 主页装修
  themeKey              String  @default("violet")
  showPromoImages       Boolean @default(true)
  showShowcasePlayers   Boolean @default(true)
  showReviews           Boolean @default(true)

  // 营业执照/实景照片
  licenseType    String
  licenseImage   String

  // 负责人信息
  contactName    String
  contactPhone   String
  contactIdCard  String?

  // 认证状态
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String?

  // 主打游戏（大厅筛选、店铺展示；顺序即优先级，首项视为主打）
  gameCategories String[]   @default([])

  // 店铺统计
  playerCount         Int        @default(0)
  rating              Decimal?   @db.Decimal(3,2)
  orderCount          Int        @default(0)
  reviewCount         Int        @default(0)
  pageViewCount       Int        @default(0)
  consultationCount   Int        @default(0)
  activityScore       Decimal?   @db.Decimal(10,4)
  rankScore           Decimal?   @db.Decimal(10,4)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  promoImages    ShopPromoImage[]
  showcasePlayers ShopShowcasePlayer[]

  @@map("shop_profiles")
}

// 店铺宣传图（含审核状态）
model ShopPromoImage {
  id           String             @id @default(cuid())
  shopProfileId String
  shopProfile  ShopProfile        @relation(fields: [shopProfileId], references: [id], onDelete: Cascade)
  url          String
  status       VerificationStatus @default(APPROVED)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([shopProfileId, sortOrder])
  @@map("shop_promo_images")
}

// 店铺主打陪玩（店家自建名册，非平台 PLAYER 账号）
model ShopShowcasePlayer {
  id            String      @id @default(cuid())
  shopProfileId String
  shopProfile   ShopProfile @relation(fields: [shopProfileId], references: [id], onDelete: Cascade)
  displayName   String
  avatar        String?
  gameTags      String[]    @default([])
  pricePerHour  Decimal?    @db.Decimal(10, 2)
  highlight     String?
  sortOrder     Int         @default(0)
  isFeatured    Boolean     @default(true)
  isOnline      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([shopProfileId, sortOrder])
  @@map("shop_showcase_players")
}

// 老板收藏店铺
model ShopFavorite {
  id         String   @id @default(cuid())
  shopUserId String
  bossUserId String
  createdAt  DateTime @default(now())

  @@unique([shopUserId, bossUserId])
  @@index([bossUserId])
  @@map("shop_favorites")
}

// ============================================================
// 老板实名认证
// ============================================================
model RealNameVerification {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  realName      String
  idCardNumber  String
  status        RealNameStatus  @default(PENDING)
  notes         String?
  submittedAt   DateTime        @default(now())
  verifiedAt    DateTime?

  @@index([status])
  @@map("real_name_verifications")
}

// ============================================================
// 验证码记录
// ============================================================
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String
  code       String
  type      VerificationCodeType
  expiresAt DateTime
  used      Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([target, type])
  @@index([expiresAt])
  @@map("verification_codes")
}

// ============================================================
// 认证申请记录（审核后台用）
// ============================================================
model Verification {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicantType  UserRole
  status         VerificationStatus @default(PENDING)
  reviewer       String?
  reviewerNotes  String?
  reviewedAt     DateTime?

  submittedAt    DateTime @default(now())

  @@map("verifications")
}

// ============================================================
// 即时聊天消息
// ============================================================
model Message {
  id          String   @id @default(cuid())
  fromId      String
  from        User     @relation("SentMessages", fields: [fromId], references: [id])
  toId        String
  to          User     @relation("ReceivedMessages", fields: [toId], references: [id])

  // 消息类型
  type        String   @default("text")
  content     String

  // 附加数据（JSON）
  metadata    Json?

  // 状态
  isRead      Boolean  @default(false)
  readAt      DateTime?

  createdAt   DateTime @default(now())

  @@index([toId, isRead])
  @@map("messages")
}

// ============================================================
// 会话记录（用于展示聊天列表）
// ============================================================
model Conversation {
  id          String   @id @default(cuid())
  participants String[]
  lastMessage String?
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("conversations")
}

// ============================================================
// 店铺评价
// ============================================================
enum ReviewRequestStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model ShopReviewRequest {
  id             String              @id @default(cuid())
  shopUserId     String
  bossUserId     String
  conversationId String

  status         ReviewRequestStatus @default(PENDING)
  expiresAt      DateTime

  review         ShopReview?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([shopUserId, bossUserId, createdAt])
  @@index([bossUserId, status])
  @@index([shopUserId, status])
  @@map("shop_review_requests")
}

model ShopReview {
  id           String       @id @default(cuid())
  shopUserId   String
  bossUserId   String
  requestId    String       @unique

  score        Int
  content      String       @db.VarChar(500)
  isAnonymous  Boolean      @default(false)
  status       ReviewStatus @default(PUBLISHED)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  request      ShopReviewRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([shopUserId, bossUserId, createdAt])
  @@index([shopUserId, status, createdAt])
  @@map("shop_reviews")
}

model ShopPageView {
  id         String   @id @default(cuid())
  shopUserId String
  visitorId  String?
  visitorKey String // dedupe: userId or ip:hash
  source     String?
  createdAt  DateTime @default(now())

  @@index([shopUserId, createdAt])
  @@index([shopUserId, visitorKey, createdAt])
  @@map("shop_page_views")
}

model ShopConsultation {
  id         String   @id @default(cuid())
  shopUserId String
  bossUserId String
  createdAt  DateTime @default(now())

  @@unique([shopUserId, bossUserId])
  @@index([shopUserId, createdAt])
  @@map("shop_consultations")
}

// 应用级 KV（如热门榜每日刷新日期）
model AppKv {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_kv")
}
