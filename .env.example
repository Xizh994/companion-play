# ================================================================
# 搭子星 (DaziStar) 环境变量配置
# 复制此文件为 .env 并填写实际值:  cp .env.example .env
# ================================================================

# --- 数据库 ---
# PostgreSQL 连接字符串
DATABASE_URL="postgresql://dazistar:DaziStar2026!@localhost:5432/dazistar"

# --- JWT 认证 ---
# 用于签发和验证 JWT Token，务必修改为随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-random-64-char-string"

# --- NextAuth (备用，当前未完全启用) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# --- 阿里云短信服务 ---
# 获取方式: 阿里云控制台 -> RAM 访问控制 -> 创建 AccessKey
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
# 短信签名名称 (阿里云短信控制台 -> 国内消息 -> 签名管理)
ALIYUN_SMS_SIGN_NAME="速通互联验证码"
# 模板代码：100001=登录/注册，100002=修改手机，100003=重置密码
ALIYUN_SMS_TEMPLATE_CODE="100001"

# --- 阿里云邮件推送 ---
# 发信地址: 阿里云邮件推送控制台 -> 发信域名 -> 新建域名并验证 -> 创建发信地址
# 例如: noreply@dm.dazistar.com
ALIYUN_DM_ACCOUNT_NAME=""
# 发信人昵称 (可选，默认 "搭子星")
ALIYUN_DM_FROM_ALIAS="搭子星"

# --- AES 加密密钥 (用于身份证号加密存储) ---
AES_ENCRYPT_KEY=""

# --- 阿里云实人 / 店铺验真（见 docs/design/verification-v1.md）---
# 开通信息核验与企业要素后设为 true；测试环境可在未开通时用 MOCK
ALIYUN_ID_VERIFY_ENABLED=false
ID_VERIFY_MOCK=false
SHOP_VERIFY_ENABLED=false
CLOUDAUTH_SCENE_CODE=""

# --- 应用 URL ---
# 本地默认 3000；服务器测试环境为 3001，见 docs/ENVIRONMENTS.md
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- 运行环境 ---
# PORT: 3000=生产, 3001=测试 (test.dazistar.com)
NODE_ENV="production"
PORT=3000
