# ================================================================
# 搭子星 (DaziStar) 环境变量配置
# 复制此文件为 .env 并填写实际值:  cp .env.example .env
# ================================================================

# --- 数据库 ---
# PostgreSQL 连接字符串
DATABASE_URL="postgresql://dazistar:DaziStar2026!@localhost:5432/dazistar"

# --- JWT 认证 ---
# 用于签发和验证 JWT Token，务必修改为随机字符串
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-random-64-char-string"

# --- NextAuth (备用，当前未完全启用) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# --- Resend 邮件服务 ---
# 注册获取: https://resend.com -> API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
# 发件邮箱地址（需在 Resend 中验证域名）
EMAIL_FROM="noreply@dazistar.com"

# --- 应用 URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- 运行环境 ---
NODE_ENV="production"
PORT=3000
